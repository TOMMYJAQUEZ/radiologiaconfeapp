# Variables de entorno — Radiología con Fe
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.

# ============================================================
# SUPABASE
# Obtén estos valores en: https://app.supabase.com → Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Clave de servicio — SOLO para scripts del lado del servidor.
# NUNCA expongas esta clave en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Radiología con Fe
